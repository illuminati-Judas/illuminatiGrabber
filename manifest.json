{
  "manifest_version": 3,
  "name": "illuminati Grabber",
  "version": "1.1.0",
  "description": "Download exposed webpage media plus the current X post or Telegram Web media using a local helper.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "nativeMessaging"
  ],
  "optional_permissions": ["downloads.open"],
  "action": {
    "default_title": "illuminati Grabber",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["src/scanner.js", "src/site-adapters.js", "content/telegram-result-bridge.js", "content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["src/telegram-inpage.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "key": "",
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://web.telegram.org/*"
  ]
}
